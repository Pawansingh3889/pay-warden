# Prava sandbox credentials — dashboard.prava.space → API Keys (Sandbox)
PRAVA_SECRET_KEY=sk_test_replace_me
# Sandbox host — sk_test_ keys and the published test cards only work here.
# Production is https://api.prava.space (needs an sk_live_ key).
PRAVA_API_BASE=https://sandbox.api.prava.space
# api = direct sessions API (merchant-style) | cli = linked `prava` CLI (agent wallet)
PRAVA_MODE=api

# Identifies the paying user on sessions created in api mode
PAY_WARDEN_USER_ID=demo-user
PAY_WARDEN_USER_EMAIL=you@example.com

PAY_WARDEN_POLICY=policies/default.yaml
PAY_WARDEN_DB=pay_warden_audit.sqlite3
